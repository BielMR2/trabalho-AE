{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "@context": {
            "readOnly": true,
            "type": "string"
        },
        "@id": {
            "readOnly": true,
            "type": "string"
        },
        "@type": {
            "readOnly": true,
            "type": "string"
        },
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "googlePlaceId": {
            "type": ["string", "null"]
        },
        "name": {
            "type": "string"
        },
        "location": {
            "type": ["string", "object", "null"]
        },
        "evaluations": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "@context",
        "@id",
        "@type",
        "name"
    ]
}
