{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "@context": {
            "readOnly": true,
            "type": "string"
        },
        "@id": {
            "readOnly": true,
            "type": "string"
        },
        "@type": {
            "readOnly": true,
            "type": "string"
        },
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "comment": {
            "type": ["string", "null"]
        },
        "ratings": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "criterion": {
                        "type": "string"
                    },
                    "rating": {
                        "type": "integer"
                    },
                    "netVotes": {
                        "type": "integer"
                    },
                    "currentUserVote": {
                        "type": ["integer", "null"]
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "type": ["string", "object"]
                        }
                    }
                }
            }
        },
        "establishment": {
            "type": ["string", "object"]
        }
    },
    "required": [
        "@context",
        "@id",
        "@type",
        "ratings",
        "establishment"
    ]
}
